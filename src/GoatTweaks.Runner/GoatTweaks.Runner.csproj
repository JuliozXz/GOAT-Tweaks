<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>GoatTweaks.Runner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../third_party/RyTuneX/Helpers/OptimizeSystemHelper.cs" Link="RyTuneX/Helpers/OptimizeSystemHelper.cs" />
    <ProjectReference Include="../GoatTweaks.Core/GoatTweaks.Core.csproj" />
  </ItemGroup>
</Project>
