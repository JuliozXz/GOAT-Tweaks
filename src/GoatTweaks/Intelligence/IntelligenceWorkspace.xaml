<UserControl x:Class="GoatTweaks.Intelligence.IntelligenceWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{StaticResource TextBrush}" Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="PlainRow" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,5,7"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="#FFB4BD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style x:Key="Body" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource PanelCard}"><Setter Property="Padding" Value="15"/><Setter Property="Margin" Value="0,0,9,10"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CompactCard}" Background="#171018" BorderBrush="#4F2431">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,14,0"><TextBlock Text="INTELLIGENCE ENGINE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceTitle" Text="Entenda. Planeje. Meça." FontSize="22" FontWeight="SemiBold" Margin="0,5,0,6"/><TextBlock x:Name="ScannerFinishedLabel" Text="✓ Scan finalizado" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" Visibility="Collapsed" Margin="0,0,0,6"/><TextBlock Text="Evidências locais, alterações autorizadas e resultados rastreáveis. Sem ganhos de FPS inventados." Style="{StaticResource Body}"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SessionStatus" Text="Novo atendimento" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Right"/><Button Content="Novo atendimento" Click="NewSession_Click" Margin="0,8,0,0" FontSize="11"/></StackPanel>
   </Grid>
  </Border>
  <ItemsControl x:Name="StepsList" Grid.Row="1" Margin="0,0,0,5"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Stage}" Click="Step_Click" Padding="9,6" FontSize="10" Margin="0,0,5,6" Foreground="{Binding Brush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <StackPanel Grid.Row="2" Margin="0,0,8,8"><ProgressBar x:Name="WorkProgress" Height="3" Minimum="0" Maximum="1" Value="0"/><TextBlock x:Name="ScannerProgressLabel" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10" IsHitTestVisible="False"/></StackPanel>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="3" SelectionChanged="WorkspaceTabs_SelectionChanged">
   <TabItem Header="Identificação">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,5,9,10" x:Name="IdentificationFields">
      <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Objetivo do atendimento" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Escolha o perfil e descreva o problema. O diagnóstico não altera configurações." Style="{StaticResource Body}" Margin="0,6,0,14"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,12"><TextBlock Text="Perfil adaptativo" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="Context_Changed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="Janela da coleta de recursos" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DurationBox" SelectedIndex="0"><ComboBoxItem Content="12 segundos" Tag="12"/><ComboBoxItem Content="30 segundos" Tag="30"/><ComboBoxItem Content="60 segundos" Tag="60"/><ComboBoxItem Content="120 segundos" Tag="120"/></ComboBox></StackPanel>
       </Grid>
       <TextBlock x:Name="ProfileDescription" Style="{StaticResource Body}" Margin="0,0,0,14"/>
       <TextBlock Text="Problema relatado pelo cliente" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SymptomBox" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" TextChanged="Context_Changed"/>
       <TextBlock Text="Objetivos personalizados (perfil Personalizado)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="ObjectivesBox" TextChanged="Context_Changed"/>
      </StackPanel></Border>
      <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Jogo e condições do teste" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Preencha para comparar antes e depois. Sem essas condições, a análise de ganhos permanece inconclusiva." Style="{StaticResource Body}" Margin="0,6,0,15"/>
       <TextBlock Text="Referência do jogo (opcional)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GameReferenceBox" SelectionChanged="GameReference_Changed" Margin="0,0,0,10"/>
       <TextBlock x:Name="GameReferenceSummary" Style="{StaticResource Body}" Margin="0,0,0,15"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,12,12"><TextBlock Text="Nome do jogo / objetivo" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GameBox" TextChanged="Context_Changed"/></StackPanel>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Executável do jogo (ex.: cs2.exe)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProcessBox" TextChanged="Context_Changed"/></StackPanel>
        <StackPanel Margin="0,0,12,12"><TextBlock Text="Versão do jogo" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VersionBox" TextChanged="Context_Changed"/></StackPanel>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Cena / mapa / percurso reproduzível" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ScenarioBox" TextChanged="Context_Changed"/></StackPanel>
        <StackPanel Margin="0,0,12,12"><TextBlock Text="Resolução" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ResolutionBox" TextChanged="Context_Changed"/></StackPanel>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Qualidade gráfica / API / ray tracing" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GraphicsBox" TextChanged="Context_Changed"/></StackPanel>
        <StackPanel Margin="0,0,12,12"><TextBlock Text="Taxa de atualização do monitor" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RefreshBox" TextChanged="Context_Changed"/></StackPanel>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Limite de FPS (ou sem limite)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LimitBox" TextChanged="Context_Changed"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="V-Sync / VRR / sincronização" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SyncBox" TextChanged="Context_Changed"/>
       <CheckBox x:Name="ShadersCheck" Content="Shaders compilados e cena aquecida antes da medição" Checked="Context_Changed" Unchecked="Context_Changed" Margin="0,13,0,8"/>
       <CheckBox x:Name="ConditionsCheck" Content="Conferi e registrei as condições da medição" Checked="Context_Changed" Unchecked="Context_Changed"/>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button x:Name="ScannerButton" Content="Iniciar verificação do sistema operacional" Style="{StaticResource PrimaryButton}" Click="Scanner_Click" Margin="0,0,8,8" Visibility="Collapsed"/><Button x:Name="DiagnoseButton" Content="Executar GOAT Intelligence" Style="{StaticResource PrimaryButton}" Click="Diagnose_Click" Margin="0,0,8,0"/><Button Content="Atendimentos salvos" Click="History_Click"/></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Diagnóstico">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,5,9,10">
     <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Computador e compatibilidade" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MachineSummary" Text="Execute uma análise para identificar o computador." Style="{StaticResource Body}" Margin="0,9,0,0"/><TextBlock x:Name="CompatibilitySummary" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
     <TextBlock Text="EVIDÊNCIAS E PRÓXIMOS TESTES" Style="{StaticResource Eyebrow}" Margin="0,9,0,12"/>
     <ItemsControl x:Name="FindingsList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,7"/><TextBlock Text="{Binding Evidence}" Style="{StaticResource Body}"/><TextBlock Text="{Binding NextTest}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Processos observados" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Média de CPU no intervalo e RAM residente. Nenhum processo é encerrado automaticamente." Style="{StaticResource Body}" Margin="0,6,0,10"/><ItemsControl x:Name="ProcessesList"/></StackPanel></Border>
     <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Inicialização e armazenamento" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="StartupSummary" Style="{StaticResource Body}" Margin="0,9,0,0"/><TextBlock x:Name="StorageSummary" Style="{StaticResource Body}" Margin="0,10,0,0"/></StackPanel></Border>
     <Button Content="Ver plano personalizado →" Click="Plan_Click" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Plano e execução">
    <Grid Margin="0,5,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="PlanStatus" Text="Faça o diagnóstico inicial. Nenhum ajuste vem autorizado por padrão." Style="{StaticResource Body}" Margin="0,0,9,12"/>
     <ListBox x:Name="RecommendationsList" Grid.Row="1" ItemContainerStyle="{StaticResource PlainRow}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactCard}"><StackPanel>
      <DockPanel><CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAuthorize}" Checked="PlanSelection_Changed" Unchecked="PlanSelection_Changed" Margin="0,0,5,0" ToolTip="Somente ajustes gerenciados elegíveis podem ser selecionados para autorização."/><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
      <TextBlock Text="{Binding Classification}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,9,0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding Level}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
      <TextBlock Text="{Binding Evidence}" Style="{StaticResource Body}" Margin="0,9,0,8"/>
      <Expander Header="Evidência, proposta, risco e restauração" Foreground="{StaticResource TextBrush}" FontSize="12"><TextBlock Text="{Binding Details}" Style="{StaticResource Body}" Margin="0,12,0,0"/></Expander>
     </StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     <StackPanel Grid.Row="2" Margin="0,12,9,0"><WrapPanel>
      <Button x:Name="ApproveButton" Content="Autorizar aplicação de sugestão" Click="Approve_Click" Margin="0,0,7,7" IsEnabled="False" FontSize="11"/>
      <Button x:Name="ExecuteButton" Content="Aplicar sugestão autorizada" Style="{StaticResource PrimaryButton}" Click="Execute_Click" Margin="0,0,7,7" IsEnabled="False" FontSize="11"/>
      <Button x:Name="RestoreButton" Content="Restaurar mudanças gerenciadas" Click="Restore_Click" Margin="0,0,7,7" IsEnabled="False" FontSize="11"/>
      <Button x:Name="RebootButton" Content="Salvar / conferir reinicialização" Click="Restart_Click" Margin="0,0,7,7" FontSize="11"/>
     </WrapPanel><TextBlock x:Name="RestartStatus" Text="O atendimento é salvo localmente. Ao reabrir, use Atendimentos para retomar; nenhuma alteração é reaplicada sozinha." Style="{StaticResource Body}" Margin="0,0,0,8"/>
      <TextBox x:Name="ExecutionLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Monitor">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,5,9,10">
     <TextBlock x:Name="TelemetryStatus" Text="Aguardando coleta. O monitor avançado não permanece ativo em segundo plano." Style="{StaticResource Body}" Margin="0,0,0,14"/>
     <UniformGrid Columns="2">
      <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="CPU · medição Windows" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CpuMetric" Text="Não disponível" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="CpuThreadMetric" Style="{StaticResource Body}" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="RAM · memória física" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="RamMetric" Text="Não disponível" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="MemoryMetric" Style="{StaticResource Body}" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="GPU · motor 3D mais ocupado" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="GpuMetric" Text="Não disponível" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Não representa, isoladamente, um gargalo." Style="{StaticResource Body}" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Armazenamento · atividade total" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="DiskMetric" Text="Não disponível" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="DiskLatencyMetric" Style="{StaticResource Body}" Margin="0,8,0,0"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="CPU · histórico da coleta (%)" FontSize="15" FontWeight="SemiBold"/><Canvas x:Name="CpuHistory" Height="130" Margin="0,14,0,8" Background="#0D0D12" SizeChanged="CpuHistory_SizeChanged" ClipToBounds="True"/><TextBlock x:Name="SensorSummary" Text="Temperaturas e frequências: não disponíveis até detectar sensores compatíveis." Style="{StaticResource Body}"/><TextBlock x:Name="PowerSummary" Style="{StaticResource Body}" Margin="0,8,0,0"/></StackPanel></Border>
     <WrapPanel><Button Content="Coletar recursos agora" Click="Monitor_Click" Margin="0,0,8,8"/><Button Content="Parar coleta" Click="Stop_Click" Margin="0,0,8,8"/></WrapPanel>
     <TextBlock Text="CPU/RAM/GPU/disco são leituras da janela iniciada pelo técnico. Inventário de modelos e drivers é um snapshot. Temperaturas e clocks dependem de sensores compartilhados existentes; valores ausentes não são estimados." Style="{StaticResource Body}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Testes e relatório">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,5,9,10">
     <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Validação antes e depois" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use a mesma cena, versão, resolução, qualidade, limite de FPS e sincronização. Complete e confirme as condições em Identificação." Style="{StaticResource Body}" Margin="0,8,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,12"><TextBlock Text="Fase desta medição" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PhaseBox" SelectedIndex="0"><ComboBoxItem Content="Antes"/><ComboBoxItem Content="Depois"/></ComboBox></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="Swap chain (opcional; para CSV com múltiplas)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SwapChainBox"/></StackPanel>
      </Grid>
      <WrapPanel><Button x:Name="ImportButton" Content="Importar CSV PresentMon" Click="Import_Click" Margin="0,0,8,8"/><Button x:Name="CaptureButton" Content="Capturar com PresentMon instalado" Click="Capture_Click" Margin="0,0,8,8"/></WrapPanel>
      <TextBlock Text="Formato suportado: PresentMon --v1_metrics / MsBetweenPresents. O importador separa processos e swap chains. Não há injeção, alteração de jogo ou manipulação de anticheat." Style="{StaticResource Body}"/>
     </StackPanel></Border>
     <ItemsControl x:Name="BenchmarksList" Margin="0,0,0,10"/>
     <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Comparação medida" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ComparisonSummary" Text="Inconclusivo · faltam testes antes/depois." TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock x:Name="ComparisonDetails" Style="{StaticResource Body}" Margin="0,10,0,0"/></StackPanel></Border>
     <WrapPanel><Button x:Name="ValidateButton" Content="Repetir diagnóstico após alterações" Click="Validate_Click" Margin="0,0,8,8"/><Button x:Name="ReportButton" Content="Exportar relatório HTML" Click="Report_Click" Margin="0,0,8,8"/></WrapPanel>
     <Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Análise avançada opcional · Windows Performance Toolkit" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ToolsSummary" Style="{StaticResource Body}" Margin="0,8,0,12"/><WrapPanel><Button x:Name="WprButton" Content="Gravar WPR por 30 s" Click="Wpr_Click" Margin="0,0,8,8"/><Button x:Name="WpaButton" Content="Abrir ETL no WPA" Click="Wpa_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="WPR usa uma instância própria e captura delimitada em memória. WPA exige análise do técnico. Um arquivo ETL não é transformado automaticamente em ganho de FPS." Style="{StaticResource Body}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Atendimentos">
    <Grid Margin="0,5,9,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Histórico local · backups específicos, plano, medições e resultados. Retomar nunca reaplica mudanças sem autorização." Style="{StaticResource Body}" Margin="0,0,0,14"/>
     <ListBox x:Name="SessionsList" Grid.Row="1" DisplayMemberPath="DisplayName"/>
     <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Atualizar histórico" Click="RefreshSessions_Click" Margin="0,0,8,8"/><Button x:Name="ResumeSessionButton" Content="Retomar atendimento selecionado" Click="Resume_Click" Margin="0,0,8,8"/><Button Content="Salvar atendimento atual" Click="Save_Click" Margin="0,0,8,8"/></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Conhecimento">
    <Grid Margin="0,5,9,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="BASE TÉCNICA · FUNÇÕES PRESERVADAS E REGRAS DO MOTOR" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
     <TextBox x:Name="KnowledgeSearch" Grid.Row="1" TextChanged="KnowledgeSearch_Changed" ToolTip="Pesquisar por nome em português, nome técnico ou categoria" Margin="0,0,0,12"/>
     <ListBox x:Name="KnowledgeList" Grid.Row="2" ItemContainerStyle="{StaticResource PlainRow}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,6,0,4"/><TextBlock Text="{Binding Reliability}" Style="{StaticResource Body}"/><Expander Header="Ficha técnica e fontes" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"><TextBlock Text="{Binding Details}" Style="{StaticResource Body}" Margin="0,10,0,0"/></Expander></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="4" Margin="0,12,9,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Interromper coleta" Click="Stop_Click" FontSize="10" Padding="9,5" Margin="10,0,0,0" IsEnabled="False"/><TextBlock x:Name="WorkspaceStatus" Text="Pronto · diagnóstico sem alterações por padrão" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>
