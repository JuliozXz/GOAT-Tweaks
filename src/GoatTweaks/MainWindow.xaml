<Window x:Class="GoatTweaks.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT Tweaks · Painel de atendimento" Style="{StaticResource {x:Type Window}}"
        Height="930" Width="1490" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="PlainRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HardwareName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,13,0,8" />
        </Style>
        <Style x:Key="HardwareSubtext" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers><DataTrigger Binding="{Binding IsDetecting}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="ShellGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="218" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="QueueColumn" Width="0" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="94" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,24,12,14">
                <StackPanel DockPanel.Dock="Top" Margin="12,0,8,22">
                    <Grid><TextBlock Text="GOAT" FontSize="29" FontWeight="Black" /><Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#4E232E" BorderThickness="1" CornerRadius="5" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="v2.0" FontSize="10" Foreground="{StaticResource WarningBrush}" /></Border></Grid>
                    <TextBlock Text="T W E A K S" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="1,0,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelCard}" Padding="11" Margin="0,12,0,0" Background="#19191F">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Width="32" Height="32"><TextBlock Text="{Binding Hardware.Avatar}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Hardware.UserName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hardware.UserName}" /><TextBlock Text="{Binding Hardware.ComputerName}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="SectionsList" SelectionChanged="SectionsList_SelectionChanged" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="26,18,26,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SearchColumn" Width="260" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock x:Name="SectionEyebrow" Style="{StaticResource Eyebrow}" Text="PAINEL DE ATENDIMENTO" Margin="0,0,0,5" /><TextBlock x:Name="SectionTitle" Text="Visão geral" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="35,11,30,11" VerticalContentAlignment="Center" ToolTip="Pesquisar ação, serviço, tópico ou origem em todo o catálogo" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Pesquisar no catálogo" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="Buscar no catálogo…" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <Button Content="×" Click="ClearSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5,1" Margin="0,0,7,0" FontSize="13" BorderThickness="0" Background="Transparent" ToolTip="Limpar pesquisa" />
            </Grid>
            <Button Grid.Column="2" Content="{Binding QueueButton}" Click="ReviewQueue_Click" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Padding="12,12" />
        </Grid>
        <ScrollViewer x:Name="DashboardPanel" Grid.Column="1" Grid.Row="1" Margin="26,0,18,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel Margin="0,0,8,20">
                <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding Hardware.Greeting}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Cada área do computador, no lugar certo." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="13" /><TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="10" TextWrapping="Wrap" /></StackPanel>
                    <Button Grid.Column="1" Content="Meu hardware  →" Tag="Hardware" Click="Navigate_Click" VerticalAlignment="Top" Margin="0,6,0,0" FontSize="12" />
                </Grid>
                <UniformGrid x:Name="HardwareCardsGrid" Columns="4" Margin="0,0,-12,20">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,12,10" Padding="17" MinHeight="146"><StackPanel><DockPanel><TextBlock Text="&#xE950;" Style="{StaticResource Glyph}" Margin="0,0,10,0" /><TextBlock Text="PROCESSADOR" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" /></DockPanel><TextBlock Text="{Binding Hardware.CpuName}" Style="{StaticResource HardwareName}" /><TextBlock Text="{Binding Hardware.CpuSummary}" Style="{StaticResource HardwareSubtext}" /></StackPanel></Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,12,10" Padding="17" MinHeight="146"><StackPanel><DockPanel><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Margin="0,0,10,0" /><TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" /></DockPanel><TextBlock Text="{Binding Hardware.GpuName}" Style="{StaticResource HardwareName}" /><TextBlock Text="{Binding Hardware.GpuSummary}" Style="{StaticResource HardwareSubtext}" /></StackPanel></Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,12,10" Padding="17" MinHeight="146"><StackPanel><DockPanel><TextBlock Text="&#xE964;" Style="{StaticResource Glyph}" Margin="0,0,10,0" /><TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" /></DockPanel><TextBlock Text="{Binding Hardware.RamCapacity}" FontSize="25" FontWeight="SemiBold" Margin="0,13,0,8" /><TextBlock Text="{Binding Hardware.RamSummary}" Style="{StaticResource HardwareSubtext}" /></StackPanel></Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,12,10" Padding="17" MinHeight="146"><StackPanel><DockPanel><TextBlock Text="&#xE977;" Style="{StaticResource Glyph}" Margin="0,0,10,0" /><TextBlock Text="PLACA-MÃE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" /></DockPanel><TextBlock Text="{Binding Hardware.BoardName}" Style="{StaticResource HardwareName}" /><TextBlock Text="{Binding Hardware.BoardSummary}" Style="{StaticResource HardwareSubtext}" /></StackPanel></Border>
                </UniformGrid>
                <Grid x:Name="MonitorRow" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.75*" /><ColumnDefinition x:Name="GuideColumn" Width="1*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="MonitorCard" Style="{StaticResource PanelCard}" Margin="0,0,16,0" Padding="20,18" MinHeight="340">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="170" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel><TextBlock Text="Desempenho agora" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="CpuChartButton" Content="CPU" Tag="cpu" IsChecked="True" Click="ChartMetric_Click" Style="{StaticResource TopicButton}" Padding="12,5" Margin="14,0,5,0" /><ToggleButton x:Name="RamChartButton" Content="RAM" Tag="ram" Click="ChartMetric_Click" Style="{StaticResource TopicButton}" Padding="12,5" Margin="0" /></StackPanel></DockPanel>
                            <Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ChartValue}" FontSize="31" FontWeight="SemiBold" /><TextBlock Text="{Binding ChartDetail}" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="14,0,0,4" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChartDetail}" /></Grid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid><TextBlock Text="100%" Foreground="#777786" FontSize="9" VerticalAlignment="Top" /><TextBlock Text="50%" Foreground="#777786" FontSize="9" VerticalAlignment="Center" /><TextBlock Text="0" Foreground="#777786" FontSize="9" VerticalAlignment="Bottom" /></Grid>
                                <Grid x:Name="TrendPlot" Grid.Column="1" ClipToBounds="True" SizeChanged="TrendPlot_SizeChanged" Background="Transparent">
                                    <Path x:Name="TrendGrid" Stroke="#28232C" StrokeThickness="1" StrokeDashArray="3,5" />
                                    <Path x:Name="TrendArea"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#80482532" Offset="0" /><GradientStop Color="#0030141C" Offset="1" /></LinearGradientBrush></Path.Fill></Path>
                                    <Path x:Name="TrendLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                    <TextBlock x:Name="TrendEmptyLabel" Text="Aguardando amostras do Windows…" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12" />
                                </Grid>
                            </Grid>
                            <DockPanel Grid.Row="3" Margin="32,8,0,0"><TextBlock Text="últimos 60 segundos" Foreground="#777786" FontSize="9" /><TextBlock Text="agora" Foreground="#777786" FontSize="9" HorizontalAlignment="Right" /></DockPanel>
                            <DockPanel Grid.Row="4" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" /><TextBlock Text="CPU " FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding CpuPercent}" FontSize="10" /><TextBlock Text="    RAM " FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding RamPercent}" FontSize="10" /></StackPanel><TextBlock Text="Atualização a cada 2 s" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="9" /></DockPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="GuideCard" Grid.Column="1" Style="{StaticResource PanelCard}" Padding="18" MinHeight="340">
                        <StackPanel><TextBlock Text="Seu atendimento, por etapas" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <Button Style="{StaticResource ServiceTile}" Tag="Hardware" Click="Navigate_Click" Padding="10,9" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="Identificar o computador" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="CPU, GPU, RAM e placa-mãe" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                            <Button Style="{StaticResource ServiceTile}" Tag="Prepare" Click="Navigate_Click" Padding="10,9" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="Preparar o atendimento" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Restauração e backup do Registro" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                            <Button Style="{StaticResource ServiceTile}" Tag="clean" Click="Navigate_Click" Padding="10,9" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="Escolher os serviços" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Áreas separadas por assunto" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                            <Button Style="{StaticResource ServiceTile}" Tag="Queue" Click="Navigate_Click" Padding="10,9" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="04" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="Revisar e executar a fila" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding QueueSummary}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,14"><TextBlock Text="Serviços por área" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="11 áreas · 619 ações" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                <ItemsControl x:Name="ServiceTiles" Margin="0,0,-12,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="ServiceTilesGrid" Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource ServiceTile}" Tag="{Binding Id}" Click="Navigate_Click" Margin="0,0,12,12" MinHeight="148"><StackPanel><Grid Margin="0,0,0,15"><Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="9" HorizontalAlignment="Left"><TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" /></Border><TextBlock Text="{Binding Number}" FontSize="11" Foreground="#7F737D" HorizontalAlignment="Right" Margin="0,5,0,0" /></Grid><TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding CountLabel}" FontSize="10" Foreground="{StaticResource WarningBrush}" Margin="0,7,0,0" /><TextBlock Text="{Binding Preview}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="30" Margin="0,8,0,0" ToolTip="{Binding Preview}" /></StackPanel></Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="HardwarePanel" Grid.Column="1" Grid.Row="1" Margin="26,0,26,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel><Border Style="{StaticResource PanelCard}" BorderBrush="#57232D" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Conheça a máquina do cliente" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding HardwareStatus}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0" /><TextBlock Text="Dados consultados localmente. Informações ausentes são identificadas; modelos e gerações dependem do que o fabricante fornece ao Windows." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel><Button Grid.Column="1" Content="Atualizar leitura" Style="{StaticResource RefreshButton}" Click="RefreshHardware_Click" VerticalAlignment="Top" /></Grid></Border>
                <Border Style="{StaticResource PanelCard}" Padding="20,6"><ItemsControl ItemsSource="{Binding Hardware.Details}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,18,0" /><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="13" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                <WrapPanel Margin="0,18,0,0"><Button Content="CPU e memória  →" Tag="cpu" Click="Navigate_Click" Margin="0,0,10,8" /><Button Content="Placa de vídeo  →" Tag="gpu" Click="Navigate_Click" Margin="0,0,10,8" /><Button Content="Drivers e periféricos  →" Tag="devices" Click="Navigate_Click" Margin="0,0,10,8" /></WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LibraryPanel" Grid.Column="1" Grid.Row="1" Margin="26,0,20,8" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel x:Name="ServiceIntro" Margin="0,0,0,17"><TextBlock x:Name="ServiceHeading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="ServiceDescription" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" /></StackPanel>
            <Border x:Name="ModePanel" Grid.Row="1" Style="{StaticResource PanelCard}" Padding="14,11" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock x:Name="ModeLabel" Text="Modo cliente" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Ações sensíveis são identificadas e exigem o modo avançado." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="AdvancedModeCheck" Grid.Column="1" Content="Avançado" VerticalAlignment="Center" Checked="AdvancedModeCheck_Changed" Unchecked="AdvancedModeCheck_Changed" IsEnabled="{Binding CanEditQueue, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="12" ToolTip="Libera ações sensíveis nesta sessão, sem confirmação digitada." /></Grid></Border>
            <StackPanel x:Name="FiltersPanel" Grid.Row="2"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Text="ESCOLHA UM ASSUNTO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" /><ComboBox x:Name="OriginFilter" Grid.Column="1" SelectionChanged="OriginFilter_SelectionChanged" SelectedIndex="0" FontSize="11" MinHeight="32" ToolTip="Filtrar pela origem"><ComboBoxItem Content="Todas as origens" Tag="all" /><ComboBoxItem Content="Ultimate" Tag="Ultimate" /><ComboBoxItem Content="winutil" Tag="winutil" /><ComboBoxItem Content="RyTuneX" Tag="RyTuneX" /><ComboBoxItem Content="WinSux" Tag="WinSux" /></ComboBox></Grid>
                <ItemsControl x:Name="TopicsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Label}" Tag="{Binding Topic}" IsChecked="{Binding Selected, Mode=OneWay}" Style="{StaticResource TopicButton}" Click="Topic_Click" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
            <DockPanel Grid.Row="3" Margin="1,6,8,10"><TextBlock x:Name="ResultsLabel" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" /><Button x:Name="ResetFiltersButton" Content="Limpar filtros" Click="ResetFilters_Click" Padding="8,4" FontSize="10" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" /></DockPanel>
            <ListBox x:Name="CardsList" Grid.Row="4" ItemContainerStyle="{StaticResource PlainRow}" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.GroupStyle><GroupStyle><GroupStyle.Panel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></GroupStyle.Panel><GroupStyle.HeaderTemplate><DataTemplate><DockPanel Margin="2,9,12,12"><Rectangle Fill="{StaticResource AccentBrush}" Width="3" Height="13" Margin="0,0,9,0" /><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding ItemCount, StringFormat={} · {0} ações}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="9,0,0,0" /></DockPanel></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource PanelCard}" Padding="17,15" Margin="0,0,9,10"><StackPanel>
                        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" ToolTip="{Binding Item.Title}" /><Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="4" Padding="7,4" VerticalAlignment="Top"><TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Border></Grid>
                        <TextBlock Text="{Binding Operation}" Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding Description}" Margin="0,0,0,9" />
                        <TextBlock Text="{Binding Metadata}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Restriction}" Foreground="{StaticResource WarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="{Binding IsRestricted, Converter={StaticResource BoolVisibility}}" />
                        <WrapPanel Margin="0,12,0,0"><Button Content="+ Adicionar à fila" Tag="{Binding Item}" Style="{StaticResource CardPrimaryButton}" Click="AddButton_Click" Padding="11,7" FontSize="11" Margin="0,0,8,3" /><Button Content="Detalhes" Tag="{Binding Item}" Click="PreviewButton_Click" Padding="11,7" FontSize="11" Margin="0,0,8,3" /><Button Content="Restaurar padrão" Tag="{Binding Item}" Click="RevertButton_Click" Style="{StaticResource CardButton}" Padding="11,7" FontSize="11" Margin="0,0,0,3" Visibility="{Binding CanRevert, Converter={StaticResource BoolVisibility}}" /></WrapPanel>
                    </StackPanel></Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyResultsPanel" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="25"><TextBlock Text="Nenhuma ação encontrada" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Altere a pesquisa ou limpe os filtros para ver outras opções." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" /><Button Content="Limpar filtros" Click="ResetFilters_Click" HorizontalAlignment="Center" Margin="0,18,0,0" /></StackPanel>
            <ListBox x:Name="LogsDetailList" Grid.Row="4" Visibility="Collapsed" ItemContainerStyle="{StaticResource PlainRow}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelCard}" Padding="15" Margin="0,0,9,9"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="12,0,0,0" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="12" ToolTip="{Binding Detail}" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
        <Border x:Name="QueuePanel" Grid.Column="2" Grid.RowSpan="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition x:Name="RecentActivityRow" Height="125" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Fila de atendimento" FontSize="18" FontWeight="SemiBold" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="QueueCountLabel" Text="0" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="11" /></Border>
                </Grid>
                <TextBlock x:Name="QueueHintLabel" Grid.Row="1" Text="Adicione as ações que deseja aplicar." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" FontSize="12" />
                <Grid Grid.Row="2">
                    <ListBox x:Name="QueueList" Margin="0,0,0,10" ItemContainerStyle="{StaticResource PlainRow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="QueueCard" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11,10" Margin="0,0,5,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" Click="RemoveQueueButton_Click" IsEnabled="{Binding CanEditQueue, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Remover da fila" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Area}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Area}" Margin="0,4,0,0" /><StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Ellipse x:Name="StateDot" Width="5" Height="5" Fill="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                                                <TextBlock x:Name="StateText" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="running"><Setter TargetName="QueueCard" Property="BorderBrush" Value="#75313D" /><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource AccentBrush}" /><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="success"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource SuccessBrush}" /><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="failed"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource AccentBrush}" /><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="10">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=QueueList}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="+" FontSize="32" Foreground="#4C4C57" HorizontalAlignment="Center" />
                        <TextBlock Text="Sua fila começa aqui" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock x:Name="CurrentActionLabel" Text="Pronto para executar" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <ProgressBar x:Name="ExecutionProgress" Minimum="0" Maximum="1" Value="0" />
                    <TextBlock x:Name="RunSummaryLabel" Text="Nenhuma alteração aplicada" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <Button x:Name="ApplyButton" Content="Aplicar fila" Style="{StaticResource PrimaryButton}" Click="ApplyButton_Click" IsEnabled="False" Padding="12,11" />
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="ClearQueueButton" Content="Limpar fila" Margin="0,0,4,0" Click="ClearQueueButton_Click" FontSize="11" /><Button Grid.Column="1" Content="Pasta de logs" Margin="4,0,0,0" Click="OpenLogsFolderButton_Click" FontSize="11" /></Grid>
                </StackPanel>
                <TextBlock x:Name="RecentActivityHeading" Grid.Row="5" Text="ATIVIDADE RECENTE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,22,0,8" />
                <ListBox x:Name="LogsList" Grid.Row="6" ItemContainerStyle="{StaticResource PlainRow}">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3,5,7" ToolTip="{Binding Detail}"><TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusLabel" Grid.Column="1" Grid.Row="2" Margin="26,0" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Pronto · escolha uma área para começar" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>
</Window>
