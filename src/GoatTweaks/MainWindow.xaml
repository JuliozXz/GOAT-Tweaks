<Window x:Class="GoatTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT Tweaks" Style="{StaticResource {x:Type Window}}" Height="850" Width="1420" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="PlainRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="QueueColumn" Width="330" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,27,14,16">
                <StackPanel DockPanel.Dock="Top" Margin="9,0,0,22">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="GOAT" FontSize="26" FontWeight="Bold" /><Rectangle Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="7,12,0,0" /></StackPanel>
                    <TextBlock Text="Tweaks" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,1,0,0" />
                    <TextBlock Text="BIBLIOTECA" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,29,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,16,8,0">
                    <TextBlock Text="Escolha as ações.&#10;Aplique quando estiver pronto." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                </Border>
                <ListBox x:Name="SectionsList" SelectionChanged="SectionsList_SelectionChanged" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SectionTitle" Text="Otimizar" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" ToolTip="Pesquisar em todas as categorias" TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="Buscar ação..." Foreground="{StaticResource MutedBrush}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
        <Grid x:Name="LibraryPanel" Grid.Column="1" Grid.Row="1" Margin="24,0,22,6">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="ModeLabel" Text="Modo cliente" FontWeight="SemiBold" />
                        <TextBlock Text="Ajustes sensíveis ficam no modo avançado." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox x:Name="AdvancedModeCheck" Grid.Column="1" Content="Avançado" VerticalAlignment="Center" Checked="AdvancedModeCheck_Changed" Unchecked="AdvancedModeCheck_Changed" IsEnabled="{Binding CanEditQueue, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" ToolTip="Libera ações avançadas nesta sessão, sem confirmação digitada." />
                </Grid>
            </Border>
            <TextBlock x:Name="ResultsLabel" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="2,15,0,11" FontSize="12" />
            <ListBox x:Name="CardsList" Grid.Row="2" ItemContainerStyle="{StaticResource PlainRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18,16" Margin="0,0,9,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" Margin="0,0,12,0" ToolTip="{Binding Title}" />
                                    <Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="4" Padding="7,4" VerticalAlignment="Top"><TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Border>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="38" FontSize="12" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding Metadata}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Restriction}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Visibility="{Binding IsRestricted, Converter={StaticResource BoolVisibility}}" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="+ Adicionar" Style="{StaticResource CardPrimaryButton}" Tag="{Binding Item}" Click="AddButton_Click" Padding="12,7" Margin="0,0,8,4" />
                                    <Button Content="Detalhes" Tag="{Binding Item}" Click="PreviewButton_Click" Padding="12,7" Margin="0,0,8,4" />
                                    <Button Content="Restaurar padrão" Style="{StaticResource CardButton}" Tag="{Binding Item}" Click="RevertButton_Click" Padding="12,7" Margin="0,0,0,4" Visibility="{Binding CanRevert, Converter={StaticResource BoolVisibility}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="LogsDetailList" Grid.Row="2" Visibility="Collapsed" ItemContainerStyle="{StaticResource PlainRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,9,9">
                            <StackPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="10,0,0,0" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel>
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="{Binding Detail}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Border Grid.Column="2" Grid.RowSpan="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="18,27,18,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition x:Name="RecentActivityRow" Height="125" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Fila de ações" FontSize="20" FontWeight="SemiBold" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="QueueCountLabel" Text="0" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="11" /></Border>
                </Grid>
                <TextBlock x:Name="QueueHintLabel" Grid.Row="1" Text="Adicione as ações que deseja aplicar." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" FontSize="12" />
                <Grid Grid.Row="2">
                    <ListBox x:Name="QueueList" Margin="0,0,0,10" ItemContainerStyle="{StaticResource PlainRow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="QueueCard" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11,10" Margin="0,0,5,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" Click="RemoveQueueButton_Click" IsEnabled="{Binding CanEditQueue, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Remover da fila" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Title}" FontWeight="SemiBold" FontSize="12" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Ellipse x:Name="StateDot" Width="5" Height="5" Fill="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                                                <TextBlock x:Name="StateText" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="running"><Setter TargetName="QueueCard" Property="BorderBrush" Value="#75313D" /><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource AccentBrush}" /><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="success"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource SuccessBrush}" /><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="failed"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource AccentBrush}" /><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="10">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=QueueList}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="+" FontSize="32" Foreground="#4C4C57" HorizontalAlignment="Center" />
                        <TextBlock Text="Sua fila começa aqui" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock x:Name="CurrentActionLabel" Text="Pronto para executar" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <ProgressBar x:Name="ExecutionProgress" Minimum="0" Maximum="1" Value="0" />
                    <TextBlock x:Name="RunSummaryLabel" Text="Nenhuma alteração aplicada" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <Button x:Name="ApplyButton" Content="Aplicar fila" Style="{StaticResource PrimaryButton}" Click="ApplyButton_Click" IsEnabled="False" Padding="12,11" />
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="ClearQueueButton" Content="Limpar fila" Margin="0,0,4,0" Click="ClearQueueButton_Click" FontSize="11" /><Button Grid.Column="1" Content="Pasta de logs" Margin="4,0,0,0" Click="OpenLogsFolderButton_Click" FontSize="11" /></Grid>
                </StackPanel>
                <TextBlock x:Name="RecentActivityHeading" Grid.Row="5" Text="ATIVIDADE RECENTE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,22,0,8" />
                <ListBox x:Name="LogsList" Grid.Row="6" ItemContainerStyle="{StaticResource PlainRow}">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3,5,7" ToolTip="{Binding Detail}"><TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusLabel" Grid.Column="1" Grid.Row="2" Margin="26,0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Pronto · nenhuma alteração aplicada" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>
</Window>
