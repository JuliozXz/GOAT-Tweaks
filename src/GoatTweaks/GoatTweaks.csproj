<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GOATTweaks</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/goat-logo.png" />
    <Resource Include="Assets/goat-logo-enhanced.png" />
    <Compile Remove="Hardware/**/*.cs" />
    <ProjectReference Include="../GoatTweaks.Windows/GoatTweaks.Windows.csproj" />
    <ProjectReference Include="../GoatTweaks.Core/GoatTweaks.Core.csproj" />
    <ProjectReference Include="../GoatTweaks.Runner/GoatTweaks.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- This JSON is loaded by exact manifest name, not by ResourceManager satellite lookup. -->
    <EmbeddedResource Include="../../catalog/workflow.pt-BR.json" LogicalName="GoatTweaks.workflow.pt-BR.json" WithCulture="false" />
  </ItemGroup>
</Project>
