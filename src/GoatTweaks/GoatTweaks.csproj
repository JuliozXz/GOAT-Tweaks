<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GOATTweaks</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GoatTweaks.Core/GoatTweaks.Core.csproj" />
    <ProjectReference Include="../GoatTweaks.Runner/GoatTweaks.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../catalog/workflow.pt-BR.json" LogicalName="GoatTweaks.workflow.pt-BR.json" />
  </ItemGroup>
</Project>
